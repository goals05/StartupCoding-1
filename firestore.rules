rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                   isValidUser(request.resource.data) &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorites', 'lastRegion', 'lastProvince', 'displayName', 'photoURL', 'updatedAt']);
    }

    function isValidRecord(data) {
      return data.userId == request.auth.uid &&
             data.keys().hasAll(['userId', 'placeId', 'content', 'createdAt']) &&
             data.placeName is string &&
             data.content is string &&
             data.content.size() <= 1000;
    }

    match /travel_records/{recordId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidRecord(request.resource.data) && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
